<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/u_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_panel_up"
    android:orientation="vertical"
    android:paddingLeft="12dp" android:paddingTop="10dp" android:paddingRight="12dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/u_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="monospace" android:shadowColor="#FF0D0A14" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01" android:singleLine="true" android:text="UPCOMING" android:textColor="#FF4FD8FF" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/u_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_box_dark" android:fontFamily="monospace" android:paddingLeft="6dp" android:paddingTop="2dp" android:paddingRight="6dp" android:paddingBottom="2dp" android:textColor="#FFFFD23F" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/u_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d1" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/u_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d2" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/u_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d3" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/u_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d4" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/u_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d5" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/u_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d6" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/u_row7" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/u_d7" android:layout_width="46dp" android:layout_height="wrap_content" android:background="@drawable/w_chip" android:fontFamily="monospace" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:singleLine="true" android:textColor="#FF0D0A14" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/u_t7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/u_h7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FF8FE0FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/u_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#FFB9B4E8" android:textSize="12sp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
