<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_icon" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/w_badge" android:padding="4dp" android:scaleType="fitCenter"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="@color/w_text" android:textSize="16sp"/>
            <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text_dim" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_chip1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/w_ic1" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/w_coin" android:scaleType="fitCenter"/>
                <TextView android:id="@+id/w_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="@color/w_text" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/w_chip2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/w_ic2" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/w_flame" android:scaleType="fitCenter"/>
                <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="@color/w_text" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/w_chip3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/w_ic3" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/w_star" android:scaleType="fitCenter"/>
                <TextView android:id="@+id/w_best" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="@color/w_text" android:textSize="12sp"/>
            </LinearLayout>
            </LinearLayout>

    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/w_next_bg" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:paddingLeft="12dp" android:paddingTop="9dp" android:paddingRight="12dp" android:paddingBottom="9dp" android:textColor="@color/w_text" android:textSize="13sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                <ImageView android:id="@+id/w_c1" android:layout_width="18dp" android:layout_height="18dp" android:scaleType="fitCenter" android:src="@drawable/w_circle"/>
                <TextView android:id="@+id/w_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:ellipsize="end" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                <ImageView android:id="@+id/w_c2" android:layout_width="18dp" android:layout_height="18dp" android:scaleType="fitCenter" android:src="@drawable/w_circle"/>
                <TextView android:id="@+id/w_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:ellipsize="end" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                <ImageView android:id="@+id/w_c3" android:layout_width="18dp" android:layout_height="18dp" android:scaleType="fitCenter" android:src="@drawable/w_circle"/>
                <TextView android:id="@+id/w_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:ellipsize="end" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                <ImageView android:id="@+id/w_c4" android:layout_width="18dp" android:layout_height="18dp" android:scaleType="fitCenter" android:src="@drawable/w_circle"/>
                <TextView android:id="@+id/w_t4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:ellipsize="end" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:textColor="@color/w_text_dim" android:textSize="13sp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
