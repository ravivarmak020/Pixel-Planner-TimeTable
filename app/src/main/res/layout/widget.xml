<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_panel"
    android:orientation="vertical"
    android:paddingLeft="12dp" android:paddingTop="10dp" android:paddingRight="12dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_icon" android:layout_width="38dp" android:layout_height="38dp" android:scaleType="fitCenter"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:singleLine="true" android:shadowColor="#FF0D0A14" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01" android:text="PIXEL PLANNER" android:textColor="#FFFFD23F" android:textSize="14sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_ic1" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_coin" android:scaleType="fitCenter"/>
            <TextView android:id="@+id/w_coins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" android:fontFamily="monospace" android:singleLine="true" android:shadowColor="#FF0D0A14" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01" android:textColor="#FFFFD23F" android:textSize="12sp" android:textStyle="bold"/>
            <ImageView android:id="@+id/w_ic2" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_flame" android:scaleType="fitCenter"/>
            <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" android:fontFamily="monospace" android:singleLine="true" android:shadowColor="#FF0D0A14" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01" android:textColor="#FFFF9A1A" android:textSize="12sp" android:textStyle="bold"/>
            <ImageView android:id="@+id/w_ic3" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_star" android:scaleType="fitCenter"/>
            <TextView android:id="@+id/w_best" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" android:fontFamily="monospace" android:singleLine="true" android:shadowColor="#FF0D0A14" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01" android:textColor="#FF8FE0FF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/w_box_green" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="1" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="8dp" android:paddingBottom="4dp" android:textColor="#FFB9FF9A" android:textSize="12sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/w_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/w_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/w_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/w_t4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="monospace" android:textColor="#FFB9B4E8" android:textSize="12sp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
