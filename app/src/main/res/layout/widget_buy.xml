<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/b_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card_buy"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/b_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/w_badge" android:padding="4dp" android:scaleType="fitCenter"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:singleLine="true" android:text="To Buy" android:textColor="@color/w_text" android:textSize="15sp"/>
            <TextView android:id="@+id/b_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text_dim" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/b_count" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/w_pill" android:gravity="center" android:includeFontPadding="false" android:minWidth="26dp" android:fontFamily="sans-serif-medium" android:paddingLeft="9dp" android:paddingRight="9dp" android:textColor="@color/w_on_accent" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:gravity="top" android:orientation="vertical">
        <LinearLayout android:id="@+id/b_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row7" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_circle"/>
                <TextView android:id="@+id/b_t7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif" android:singleLine="true" android:textColor="@color/w_text" android:textSize="14sp"/>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="@drawable/w_div"/>
        </LinearLayout>
        <TextView android:id="@+id/b_more" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:includeFontPadding="false" android:paddingLeft="28dp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_accent" android:textSize="12sp" android:visibility="gone"/>
        <TextView android:id="@+id/b_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/w_text_dim" android:textSize="13sp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
