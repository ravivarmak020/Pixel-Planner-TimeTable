<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/b_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_panel_buy"
    android:orientation="vertical"
    android:padding="5dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_scene_buy"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
            <ImageView android:id="@+id/b_icon" android:layout_width="34dp" android:layout_height="34dp" android:scaleType="fitCenter"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="monospace" android:shadowColor="#FF0D0A14" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01" android:singleLine="true" android:text="TO BUY" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/b_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_box_dark" android:fontFamily="monospace" android:paddingLeft="8dp" android:paddingTop="2dp" android:paddingRight="8dp" android:paddingBottom="2dp" android:textColor="#FFFFD23F" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="8dp" android:paddingBottom="4dp">
        <LinearLayout android:id="@+id/b_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/b_row7" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/w_check"/>
            <TextView android:id="@+id/b_t7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:ellipsize="end" android:fontFamily="monospace" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        </LinearLayout>
        <TextView android:id="@+id/b_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="monospace" android:textColor="#FFFFB347" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
        <TextView android:id="@+id/b_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#FFB9B4E8" android:textSize="13sp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
